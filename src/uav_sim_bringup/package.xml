<?xml version="1.0"?>
<package format="3">
  <name>uav_sim_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for the modular UAV landing research stack.</description>
  <maintainer email="research@example.com">UAV Landing Research Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>landing_perception</exec_depend>
  <exec_depend>landing_state_estimation</exec_depend>
  <exec_depend>landing_ontology_reasoner</exec_depend>
  <exec_depend>landing_path_generator</exec_depend>
  <exec_depend>landing_safety_layer</exec_depend>
  <exec_depend>landing_controller</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

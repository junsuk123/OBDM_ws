<?xml version="1.0"?>
<package format="3">
  <name>landing_ontology_reasoner</name>
  <version>0.1.0</version>
  <description>Lightweight ontology-inspired rule reasoner for UAV landing.</description>
  <maintainer email="research@example.com">UAV Landing Research Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>landing_interfaces</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

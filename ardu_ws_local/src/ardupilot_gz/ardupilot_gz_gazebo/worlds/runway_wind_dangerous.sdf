<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="runway">
    <!-- Base runway world with strong/global wind and WindEffects plugin (dangerous) -->
    <include>
      <uri>model://runway</uri>
      <pose degrees="true">-29 545 0 0 0 363</pose>
    </include>

    <!-- strong steady wind -->
    <wind>
      <linear_velocity>6.5 0.0 0.0</linear_velocity>
    </wind>

    <!-- WindEffects plugin configured for DANGEROUS preset -->
    <plugin filename="gz-sim-wind-effects-system"
      name="gz::sim::systems::WindEffects">

      <force_approximation_scaling_factor>1.0</force_approximation_scaling_factor>

      <horizontal>
        <magnitude>
          <time_for_rise>3</time_for_rise>
          <sin>
            <amplitude_percent>0.25</amplitude_percent>
            <period>6</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.15</stddev>
          </noise>
        </magnitude>
        <direction>
          <time_for_rise>3</time_for_rise>
          <sin>
            <amplitude>0.35</amplitude>
            <period>6</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.08</stddev>
          </noise>
        </direction>
      </horizontal>

      <vertical>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.08</stddev>
        </noise>
      </vertical>

    </plugin>

  </world>
</sdf>
